# PaperSplit · Docker 部署环境变量
# ------------------------------------------------------------
# 复制本文件为 .env 即可生效：
#   cp .env.example .env
#
# 放在 deploy/ 目录下（与 docker-compose.yml 同级），compose 会自动读取。
# ------------------------------------------------------------

# 对外暴露的端口（默认 8080）
# 改这里的值即可换端口，无需改动 docker-compose.yml
PORT=8080
