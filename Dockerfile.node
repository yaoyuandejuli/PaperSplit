# syntax=docker/dockerfile:1
# ============================================================
# PaperSplit · 多阶段构建（Node 版，使用项目自带零依赖服务器）
# 与 nginx 版等价，只是运行阶段改用 scripts/serve.js 提供静态服务，
# 不依赖 nginx，镜像更小依赖链更短。
# ============================================================

# ---------- 构建阶段 ----------
# Node 版本必须满足 Vite 7 的 engines 要求（^20.19.0 || >=22.12.0）
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --foreground-scripts
COPY . .
RUN npm run build

# ---------- 运行阶段：node scripts/serve.js 8080 ----------
FROM node:22-alpine
WORKDIR /app
# 以非 root 用户运行：node 镜像自带 node 用户，无需额外创建
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/scripts ./scripts
COPY --from=build --chown=node:node /app/package.json ./package.json
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/ >/dev/null 2>&1 || exit 1
CMD ["node", "scripts/serve.js", "8080"]
