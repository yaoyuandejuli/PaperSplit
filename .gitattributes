# 统一文本文件行尾为 LF，避免 Windows 上 checkout 成 CRLF。
#
# 重点：Dockerfile / *.yml / *.conf 这类文件必须是 LF。
# CRLF 会让 Dockerfile 的续行符 `\` 失效（解析成字面量 "\r"），
# 导致 docker build 直接报 "unknown instruction" 或指令拼接错误。

* text=auto eol=lf

# 以下文件强制 LF（即使在 Windows 上 checkout 也保持 LF）
Dockerfile*            text eol=lf
*.dockerignore         text eol=lf
docker-compose*.yml    text eol=lf
*.yml                  text eol=lf
*.yaml                 text eol=lf
*.conf                 text eol=lf
*.sh                   text eol=lf
*.js                   text eol=lf
*.mjs                  text eol=lf
*.css                  text eol=lf
*.html                 text eol=lf
*.json                 text eol=lf
.gitignore             text eol=lf
.gitattributes          text eol=lf

# 二进制文件不做行尾转换
*.png                  binary
*.jpg                  binary
*.jpeg                 binary
*.gif                  binary
*.ico                  binary
*.pdf                  binary
*.woff                 binary
*.woff2                binary
*.ttf                  binary
*.eot                  binary
